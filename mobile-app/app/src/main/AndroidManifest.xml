<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera Permission -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Storage Permissions (Android 12 and below only) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Media Permissions (Android 13+) -->
    <!-- For viewing/uploading ID proof and photos in pass applications -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- For Android 14+ Selected Photos Access -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_menu_compass"
        android:supportsRtl="true"
        android:theme="@style/Theme.BusPassManagement"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="false"
        tools:targetApi="31">

        <!-- Splash Screen -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.BusPassManagement.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Auth Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.Auth"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.Auth"
            android:windowSoftInputMode="adjustResize" />

        <!-- User Activities -->
        <activity
            android:name=".activities.DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.NoActionBar" />

        <activity
            android:name=".activities.ApplyPassActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.NoActionBar" />

        <activity
            android:name=".activities.BookTicketActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.NoActionBar" />

        <activity
            android:name=".activities.MyPassesActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.NoActionBar" />

        <activity
            android:name=".activities.SmartCardActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.NoActionBar" />

        <activity
            android:name=".activities.EnhancedSmartCardActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.NoActionBar" />

        <activity
            android:name=".activities.PassDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.NoActionBar" />

        <activity
            android:name=".activities.MyApplicationsActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.NoActionBar" />

        <activity
            android:name=".activities.ReportIssueActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.NoActionBar" />

        <!-- Admin Activities -->
        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.BusPassManagement.NoActionBar" />

    </application>

</manifest>
